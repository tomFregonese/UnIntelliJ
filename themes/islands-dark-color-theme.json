        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#548AF7"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown strike",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown lists and quotes",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.quote",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#73BD79"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#868A91"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#6C9CFC"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F75464"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "property": "#C77DBB",
    "property.static": {
      "foreground": "#C77DBB",
      "italic": true
    },
    "property.readonly.static": {
      "foreground": "#C77DBB",
      "italic": true
    },
    "enumMember": {
      "foreground": "#C77DBB",
      "italic": true
    },
    "function.declaration": "#56A8F5",
    "method.declaration": "#56A8F5",
    "function": "#56A8F5",
    "method": "#56A8F5",
    "method:java": "#BCBEC4",
    "method.declaration:java": "#56A8F5",
    "method.static": {
      "italic": true
    },
    "function.defaultLibrary": "#56A8F5",
    "class": "#BCBEC4",
    "interface": "#BCBEC4",
    "enum": "#BCBEC4",
    "struct": "#BCBEC4",
    "type": "#BCBEC4",
    "namespace": "#BCBEC4",
    "typeParameter": "#16BAAC",
    "parameter": "#BCBEC4",
    "variable": "#BCBEC4",
    "variable.readonly.static": {
      "foreground": "#C77DBB",
      "italic": true
    },
    "annotation": "#B3AE60",
