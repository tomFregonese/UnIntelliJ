      "settings": {
        "foreground": "#C77DBB"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "name": "YAML anchors",
      "scope": [
        "entity.name.type.anchor.yaml",
        "variable.other.alias.yaml"
