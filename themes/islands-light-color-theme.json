  "tokenColors": [
    {
      "name": "Default text",
      "scope": [
        "source",
        "text",
        "variable",
        "meta.definition.variable",
        "variable.parameter",
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.name.class",
        "entity.other.inherited-class",
        "punctuation",
        "meta.brace",
        "keyword.operator",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#080808",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.control",
        "variable.language",
        "constant.language",
        "support.type.primitive",
        "support.type.builtin",
        "entity.name.type.primitive",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#067D17"
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "meta.template.expression",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#1750EB"
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.character.format"
      ],
      "settings": {
        "foreground": "#0037A6"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#264EFF"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C8C8C",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc comments",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C8C8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc tags",
      "scope": [
        "storage.type.class.jsdoc",
        "storage.type.class.javadoc",
        "keyword.other.documentation",
        "comment.block.documentation entity.name.type",
        "comment.block.documentation variable"
      ],
      "settings": {
        "foreground": "#8C8C8C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.function entity.name.function"
      ],
      "settings": {
        "foreground": "#00627A"
      }
    },
    {
      "name": "Function calls (JS/TS)",
      "scope": [
        "meta.function-call.ts entity.name.function",
        "meta.function-call.tsx entity.name.function",
        "meta.function-call.js entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#00627A"
      }
    },
    {
      "name": "Method calls (Java)",
      "scope": [
        "meta.method-call.java entity.name.function",
        "meta.function-call.java entity.name.function"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "name": "Fields and properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.definition.property variable",
        "variable.other.member",
        "variable.other.definition.java",
        "support.variable.property",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "name": "Constants and enum members",
      "scope": [
        "variable.other.constant.property",
        "variable.other.enummember",
        "constant.other.enum",
        "variable.other.constant.java"
      ],
      "settings": {
        "foreground": "#871094",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Annotations and decorators",
      "scope": [
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "meta.declaration.annotation",
        "meta.decorator",
        "punctuation.decorator",
        "meta.decorator entity.name.function",
        "meta.decorator variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#9E880D"
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "entity.name.type.type-parameter",
        "storage.type.generic.java",
        "meta.type.parameters entity.name.type"
      ],
      "settings": {
        "foreground": "#007E8A"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#080808"
      }
    },
    {
      "name": "Markup tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag.sgml",
        "entity.name.tag.html",
        "entity.name.tag.xml"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "Markup attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#174AD4"
      }
    },
    {
      "name": "Markup attribute values",
      "scope": [
        "meta.attribute string",
        "string.quoted.double.html",
        "string.quoted.single.html",
        "string.quoted.double.xml"
      ],
      "settings": {
        "foreground": "#067D17"
      }
    },
    {
      "name": "Markup entities",
      "scope": [
        "constant.character.entity",
        "punctuation.definition.entity"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "Angular template bindings",
      "scope": [
        "entity.other.attribute-name.ng",
        "entity.other.ng-binding-name",
        "support.type.ng-binding-name",
        "meta.ng-binding"
      ],
      "settings": {
        "foreground": "#174AD4"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less",
        "meta.property-name.scss"
      ],
      "settings": {
        "foreground": "#174AD4"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.class.scss",
        "entity.other.attribute-name.id.scss",
        "entity.name.tag.css",
        "entity.name.tag.scss",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.property-value.scss",
        "support.constant.color",
        "constant.other.color.rgb-value"
      ],
      "settings": {
        "foreground": "#067D17"
      }
    },
    {
      "name": "SCSS variables",
      "scope": [
        "variable.scss",
        "variable.other.sass",
        "variable.css"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "name": "CSS at-rules",
      "scope": [
        "keyword.control.at-rule",
        "punctuation.definition.keyword.css",
        "keyword.control.at-rule.scss"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.jsonc",
        "support.type.property-name.json punctuation.support.type.property-name"
      ],
      "settings": {
        "foreground": "#871094"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "YAML anchors",
      "scope": [
        "entity.name.type.anchor.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#9E880D"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#0033B3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link"
      ],
      "settings": {
        "foreground": "#2A65DB"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#067D17"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown strike",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown lists and quotes",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "markup.quote",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "foreground": "#0033B3"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#067D17"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#6C707E"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#0A50A1"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F50000"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "property": "#871094",
    "property.static": {
      "foreground": "#871094",
      "italic": true
    },
    "property.readonly.static": {
      "foreground": "#871094",
      "italic": true
    },
    "enumMember": {
      "foreground": "#871094",
      "italic": true
    },
    "function.declaration": "#00627A",
    "method.declaration": "#00627A",
    "function": "#00627A",
    "method": "#00627A",
    "method:java": "#080808",
    "method.declaration:java": "#00627A",
    "method.static": {
      "italic": true
    },
    "function.defaultLibrary": "#00627A",
    "class": "#080808",
    "interface": "#080808",
    "enum": "#080808",
    "struct": "#080808",
    "type": "#080808",
    "namespace": "#080808",
    "typeParameter": "#007E8A",
    "parameter": "#080808",
    "variable": "#080808",
    "variable.readonly.static": {
      "foreground": "#871094",
      "italic": true
    },
    "annotation": "#9E880D",
    "annotationMember": "#080808",
    "decorator": "#9E880D",
    "keyword": "#0033B3",
    "modifier": "#0033B3",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
